{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ci-pr-fixer",
  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN",
      "options": {
        "baseURL": "https://api.nan.builders/v1",
        "apiKey": "{env:NAN_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "glm5.3-flash": {
          "name": "glm5.3-flash"
        }
      }
    }
  }
}
